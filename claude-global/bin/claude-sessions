#!/usr/bin/env python3
"""Snapshot, shut down, and restore every wrapped Claude Code session.

  claude-sessions save      snapshot sessions (no shutdown)
  claude-sessions down      snapshot, then /exit every session
  claude-sessions restore   resume every snapshotted session, re-enter
                            worktrees, refill drafts, reopen Ghostty tabs
  claude-sessions attach X  attach a restored session (what each tab runs)
  claude-sessions status    print the snapshot

Sessions are the tmux sessions named claude-<sid8> by the shellrc claude()
wrapper. Run `down` and `restore` from a plain Ghostty tab, not inside tmux.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import termios
import time
from pathlib import Path

STATE_DIR = Path.home() / ".local/state/claude-sessions"
SNAPSHOT = STATE_DIR / "snapshot.json"
RELEASE = STATE_DIR / "tabs-release"
EXIT_DIR = Path.home() / ".local/state/claude-wrapper"
PROJECTS = Path.home() / ".claude/projects"
SESSION_RE = re.compile(r"^claude-[0-9a-f]{8}$")
# Spinner line while a turn is running, e.g. "✽ Coalescing… (2m 33s · ↓ 13.8k tokens"
BUSY_RE = re.compile(r"…\s*\((\d+[hms]\s*)+")
ANSI_RE = re.compile(r"\x1b\[[0-9;:?]*[A-Za-z]|\x1b\][^\x07]*\x07")
DIM = "\x1b[2m"
# A selection dialog also renders "❯ 1. Yes" between rules; only a bare ❯ is the prompt.
PROMPT_RE = re.compile(r"^❯(?!\s*\d+\.)")
LOSSY_RE = re.compile(r"\[(Pasted text|Image) #\d+")
RULE_MIN = 20
PASTE_BUF = "claude-sessions"
# A down that stopped partway leaves exited sessions only in the snapshot; carry them forward.
CARRY_PHASES = ("down-started", "down-complete")


def die(msg):
    print(f"claude-sessions: {msg}", file=sys.stderr)
    sys.exit(1)


def warn(msg):
    print(f"  ! {msg}", file=sys.stderr)


def tmux(*args, check=True, input=None):
    r = subprocess.run(["tmux", *args], capture_output=True, text=True, input=input)
    if check and r.returncode != 0:
        raise RuntimeError(f"tmux {' '.join(args)}: {r.stderr.strip()}")
    return r.stdout


def proc_comm(pid):
    r = subprocess.run(["ps", "-o", "comm=", "-p", str(pid)], capture_output=True, text=True)
    return r.stdout.strip()


def is_claude_pid(pid):
    return "claude" in proc_comm(pid)


def proc_cwd(pid):
    r = subprocess.run(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"], capture_output=True, text=True)
    for line in r.stdout.splitlines():
        if line.startswith("n"):
            return line[1:]
    return None


def plain(line):
    return ANSI_RE.sub("", line)


def capture(target):
    """Pane lines with SGR escapes kept, so dim suggestion text can be told from typed text."""
    return tmux("capture-pane", "-p", "-e", "-J", "-t", target).splitlines()


def is_rule(line):
    s = plain(line).strip()
    return len(s) >= RULE_MIN and s.count("─") >= len(s) * 0.9


def input_box(lines):
    """Index bounds (top_rule, bottom_rule) of the bottom-most ruled box, or None."""
    rules = [i for i, l in enumerate(lines) if is_rule(l)]
    if len(rules) < 2:
        return None
    return rules[-2], rules[-1]


def prompt_body(lines):
    """Raw lines of the prompt input box, or None if the box is a dialog/other mode."""
    box = input_box(lines)
    if box is None:
        return None
    body = lines[box[0] + 1 : box[1]]
    if not body or not PROMPT_RE.match(plain(body[0])):
        return None
    return body


def read_draft(lines):
    """Typed, unsent input text; None when empty or only a dim suggestion is shown."""
    body = prompt_body(lines)
    if body is None:
        return None
    typed = [plain(raw.split(DIM, 1)[0]).rstrip() for raw in body]
    out = [typed[0].lstrip()[1:].strip()]
    out += [l[2:] if l.startswith("  ") else l for l in typed[1:]]
    text = "\n".join(out).strip()
    return text or None


def is_busy(lines):
    box = input_box(lines)
    above = lines[: box[0]] if box else lines
    return any(BUSY_RE.search(plain(l)) for l in above[-15:])


def draft_caveat(lines, width):
    """Why a draft can't round-trip exactly, or None."""
    body = prompt_body(lines) or []
    text = "\n".join(plain(l) for l in body)
    if LOSSY_RE.search(text):
        return "contains a paste/image placeholder; its content is not saved"
    if len(body) > 1 and any(len(plain(l).rstrip()) >= width - 4 for l in body[:-1]):
        return "may be soft-wrapped; wrapped lines come back as separate lines"
    return None


def transcript_for(sid8):
    hits = sorted(PROJECTS.glob(f"*/{sid8}*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
    return hits[0] if hits else None


def transcript_cwd(path):
    """First recorded cwd: the directory `claude --resume` must run from."""
    with open(path) as f:
        for line in f:
            m = re.search(r'"cwd":"([^"]*)"', line)
            if m:
                return m.group(1)
    return None


def leader_pane(session):
    panes = tmux("list-panes", "-s", "-t", session, "-F", "#{pane_id} #{pane_pid} #{pane_width} #{pane_height}")
    leader = tmux("show", "-t", session, "-v", "@claude-leader-pid", check=False).strip()
    rows = [p.split() for p in panes.splitlines()]
    for pid_match in ([leader] if leader else []) + [None]:
        for pane_id, pid, w, h in rows:
            if (pid_match is None or pid == pid_match) and is_claude_pid(pid):
                return pane_id, int(pid), int(w), int(h)
    return None


def client_order(session):
    out = tmux("list-clients", "-t", session, "-F", "#{client_created}", check=False)
    stamps = [int(x) for x in out.split()]
    return min(stamps) if stamps else 1 << 62


def snapshot_sessions():
    names = [n for n in tmux("list-sessions", "-F", "#S", check=False).split() if SESSION_RE.match(n)]
    entries, problems = [], []
    for name in names:
        sid8 = name[len("claude-") :]
        pane = leader_pane(name)
        if pane is None:
            problems.append(f"{name}: no live claude pane")
            continue
        pane_id, pid, w, h = pane
        transcript = transcript_for(sid8)
        if transcript is None:
            problems.append(f"{name}: no transcript matching {sid8}* under {PROJECTS}")
            continue
        launch_cwd = transcript_cwd(transcript)
        live_cwd = proc_cwd(pid)
        lines = capture(pane_id)
        entries.append(
            {
                "name": name,
                "session_id": transcript.stem,
                "launch_cwd": launch_cwd,
                "worktree": live_cwd if live_cwd and live_cwd != launch_cwd else None,
                "draft": read_draft(lines),
                "draft_caveat": draft_caveat(lines, w),
                "at_prompt": prompt_body(lines) is not None,
                "busy": is_busy(lines),
                "title": tmux("display", "-p", "-t", pane_id, "#{pane_title}").strip(),
                "size": [w, h],
                "order": client_order(name),
                "pane": pane_id,
                "pid": pid,
            }
        )
    entries.sort(key=lambda e: e["order"])
    return entries, problems


def load_snapshot():
    return json.loads(SNAPSHOT.read_text()) if SNAPSHOT.exists() else None


def write_snapshot(entries, phase):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    prev = load_snapshot()
    if prev is not None:
        backup = STATE_DIR / f"snapshot.{int(prev['saved_at'])}.json"
        if not backup.exists():
            shutil.copy2(SNAPSHOT, backup)
    keep = [{k: v for k, v in e.items() if k not in ("pane", "pid", "busy", "at_prompt")} for e in entries]
    tmp = SNAPSHOT.with_suffix(".tmp")
    tmp.write_text(json.dumps({"saved_at": time.time(), "phase": phase, "sessions": keep}, indent=2))
    tmp.replace(SNAPSHOT)


def set_phase(phase):
    data = load_snapshot()
    data["phase"] = phase
    tmp = SNAPSHOT.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2))
    tmp.replace(SNAPSHOT)


def describe(e):
    bits = [e["name"], e["title"]]
    if e.get("worktree"):
        bits.append(f"worktree={e['worktree']}")
    if e.get("draft"):
        bits.append(f"draft={e['draft']!r}")
    return "  " + " | ".join(bits)


def cmd_save(args, phase="saved"):
    entries, problems = snapshot_sessions()
    for p in problems:
        warn(p)
    if problems and not args.force:
        die("refusing to snapshot with unresolved sessions (--force to skip them)")
    busy = [e for e in entries if e["busy"]]
    if busy and not args.force:
        for e in busy:
            warn(f"{e['name']} is mid-turn ({e['title']})")
        die("wait for these turns to finish, or pass --force")
    for e in entries:
        if not e["at_prompt"]:
            warn(f"{e['name']}: no idle ❯ prompt (dialog or bash/memory mode open?); its draft isn't saved")
        if e["draft_caveat"]:
            warn(f"{e['name']}: draft {e['draft_caveat']}")

    prev = load_snapshot()
    carried = []
    if prev and prev.get("phase") in CARRY_PHASES:
        live_ids = {e["session_id"] for e in entries}
        carried = [e for e in prev["sessions"] if e["session_id"] not in live_ids]
    if not entries and not carried and prev and prev["sessions"] and not args.force:
        die(f"no live sessions; refusing to overwrite the {len(prev['sessions'])}-session snapshot (--force to do it)")
    for e in carried:
        print(f"  carrying forward {e['name']} (exited by an earlier, unfinished down)")
    write_snapshot(carried + entries, phase)

    print(f"Saved {len(carried) + len(entries)} sessions to {SNAPSHOT}")
    for e in carried + entries:
        print(describe(e))
    return entries


def wait_until(pred, timeout, interval=0.5):
    end = time.time() + timeout
    while time.time() < end:
        if pred():
            return True
        time.sleep(interval)
    return False


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False


def exit_session(e):
    pane = e["pane"]
    for _ in range(3):
        lines = capture(pane)
        if prompt_body(lines) is None:
            return f"{e['name']}: no idle ❯ prompt (dialog or bash/memory mode open?); exit it by hand"
        if read_draft(lines) is None:
            break
        # Ctrl-C clears a non-empty draft; it's only sent while text is present, so it can't double-tap quit.
        tmux("send-keys", "-t", pane, "C-c")
        time.sleep(0.4)
    if read_draft(capture(pane)) is not None:
        return f"could not clear the draft in {e['name']}"
    tmux("send-keys", "-t", pane, "-l", "--", "/exit")
    time.sleep(0.4)
    if read_draft(capture(pane)) != "/exit":
        tmux("send-keys", "-t", pane, "C-c")
        return f"input in {e['name']} did not read back as /exit; aborted"
    tmux("send-keys", "-t", pane, "Enter")
    if not wait_until(lambda: not pid_alive(e["pid"]), 20):
        try:
            os.kill(e["pid"], 15)
        except ProcessLookupError:
            pass
        if not wait_until(lambda: not pid_alive(e["pid"]), 10):
            return f"{e['name']} (pid {e['pid']}) did not exit"
    tmux("kill-session", "-t", e["name"], check=False)
    return None


def cmd_down(args):
    if os.environ.get("TMUX"):
        die("run `down` from a plain Ghostty tab, not inside tmux")
    entries = cmd_save(args, phase="down-started")
    if not args.yes:
        if input(f"\nExit {len(entries)} running sessions? [y/N] ").strip().lower() != "y":
            set_phase("saved")
            die("aborted; snapshot kept")
    failures = []
    for e in entries:
        print(f"exiting {e['name']} …")
        try:
            err = exit_session(e)
        except (RuntimeError, OSError) as ex:
            err = f"{e['name']}: {ex}"
        if err:
            warn(err)
            failures.append(err)
    if failures:
        die(f"{len(failures)} session(s) still need attention; fix them, then rerun `down` (the snapshot keeps the rest)")
    set_phase("down-complete")
    print("\nAll sessions exited. Restart, open Ghostty, then run: claude-sessions restore")


def ready(pane):
    try:
        lines = capture(pane)
    except RuntimeError:
        return False
    return prompt_body(lines) is not None and not is_busy(lines)


def input_empty(pane):
    lines = capture(pane)
    return prompt_body(lines) is not None and read_draft(lines) is None


def launch(e):
    claude_bin = shutil.which("claude")
    if claude_bin is None:
        raise RuntimeError("claude not on PATH")
    EXIT_DIR.mkdir(parents=True, exist_ok=True)
    fd, exit_file = tempfile.mkstemp(prefix="claude-exit.", dir=EXIT_DIR)
    os.close(fd)
    w, h = e["size"]
    # Mirrors the shellrc claude() wrapper; destroy-unattached is set on first attach instead.
    tmux(
        "new-session", "-d", "-s", e["name"], "-x", str(w), "-y", str(h), "-c", e["launch_cwd"],
        "-e", "CLAUDE_CODE_TMUX_TRUECOLOR=1", "-e", f"CLAUDE_EXIT_FILE={exit_file}", "-e", "COLORTERM=truecolor",
        f"{claude_bin} --resume {e['session_id']}",
    )
    tmux("set", "-t", e["name"], "status-style", "bg=colour238 fg=colour250")
    tmux("set", "-t", e["name"], "@claude-running", "1")
    tmux("set", "-t", e["name"], "-F", "@claude-leader-pid", "#{pane_pid}")
    pane, pid = tmux("display", "-p", "-t", e["name"], "#{pane_id} #{pane_pid}").split()
    e["pane"], e["pid"] = pane, int(pid)


def paste(pane, text):
    """Bracketed paste via a buffer: no tmux argv parsing of leading '-' or trailing ';'."""
    tmux("load-buffer", "-b", PASTE_BUF, "-", input=text)
    tmux("paste-buffer", "-p", "-d", "-b", PASTE_BUF, "-t", pane)


def worktree_prompt(path):
    return (
        "[claude-sessions] The machine restarted and this session was resumed from its launch directory. "
        f"Re-enter your worktree now with EnterWorktree(path: \"{path}\") (cd there if EnterWorktree rejects it). "
        "Do nothing else; reply with one line confirming the cwd."
    )


def open_tab(command):
    script = f'''
tell application "Ghostty" to activate
delay 0.3
tell application "System Events"
  if name of first application process whose frontmost is true is not "ghostty" then error "Ghostty is not frontmost"
  keystroke "t" using command down
  delay 0.8
  keystroke "{command}"
  key code 36
end tell
'''
    r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip())


def restore_session(e):
    """Re-enter the worktree, then retype the draft. Returns a warning or None."""
    pane = e["pane"]
    if e.get("worktree") and proc_cwd(e["pid"]) != e["worktree"]:
        if not input_empty(pane):
            return "prompt isn't an empty ❯ input; skipped worktree re-entry and draft"
        print(f"re-entering worktree for {e['name']}: {e['worktree']}")
        paste(pane, worktree_prompt(e["worktree"]))
        time.sleep(0.5)
        tmux("send-keys", "-t", pane, "Enter")
        if not wait_until(lambda: is_busy(capture(pane)), 15):
            return "worktree prompt was not submitted; skipped its draft"
        if not wait_until(lambda: ready(pane), 180):
            return "worktree turn still running; skipped its draft"
        if proc_cwd(e["pid"]) != e["worktree"]:
            warn(f"{e['name']}: cwd is {proc_cwd(e['pid'])}, expected {e['worktree']}")
    if e.get("draft"):
        if not input_empty(pane):
            return "input isn't empty; skipped its draft"
        paste(pane, e["draft"])
    return None


def cmd_restore(args):
    if os.environ.get("TMUX"):
        die("run `restore` from a plain Ghostty tab, not inside tmux")
    data = load_snapshot()
    if data is None:
        die(f"no snapshot at {SNAPSHOT}")
    live = set(tmux("list-sessions", "-F", "#S", check=False).split())

    todo = []
    for e in data["sessions"]:
        if e["name"] in live:
            warn(f"{e['name']} is already running; skipping")
        elif not e["launch_cwd"] or not Path(e["launch_cwd"]).is_dir():
            warn(f"{e['name']}: launch dir {e['launch_cwd']} is missing; skipping")
        else:
            if e.get("worktree") and not Path(e["worktree"]).is_dir():
                warn(f"{e['name']}: worktree {e['worktree']} is gone; resuming without it")
                e["worktree"] = None
            todo.append(e)

    started = []
    for e in todo:
        print(f"resuming {e['name']} in {e['launch_cwd']}")
        try:
            launch(e)
            started.append(e)
        except RuntimeError as ex:
            warn(f"{e['name']}: {ex}")
    for e in started:
        if not wait_until(lambda: ready(e["pane"]), 90):
            warn(f"{e['name']} never reached an idle ❯ prompt; skipped its worktree/draft")
            continue
        # The SessionStart hook renames the session if --resume ever lands on a new id.
        e["name"] = tmux("display", "-p", "-t", e["pane"], "#S").strip()
        try:
            msg = restore_session(e)
        except (RuntimeError, OSError) as ex:
            msg = str(ex)
        if msg:
            warn(f"{e['name']}: {msg}")
    if started:
        set_phase("restored")

    if args.no_tabs or not started:
        print("\nAttach with: claude-sessions attach <name>")
        for e in started:
            print(f"  {e['name']}  {e['title']}")
        return

    # Tabs block until every tab is open, so a stray keystroke lands in a waiting shell, never in Claude.
    RELEASE.unlink(missing_ok=True)
    self_path = os.path.realpath(sys.argv[0])
    for e in started[1:]:
        try:
            open_tab(f"{self_path} attach --wait {e['name']}")
        except RuntimeError as err:
            warn(f"could not open a Ghostty tab for {e['name']} ({err}); attach it with: claude-sessions attach {e['name']}")
    RELEASE.touch()
    cmd_attach(argparse.Namespace(name=started[0]["name"], wait=False))


def cmd_attach(args):
    name = args.name
    if args.wait and not wait_until(RELEASE.exists, 900):
        die("timed out waiting for restore to finish opening tabs")
    if sys.stdin.isatty():
        termios.tcflush(sys.stdin, termios.TCIFLUSH)
    tmux("set", "-t", name, "destroy-unattached", "on")
    exit_file = tmux("show-environment", "-t", name, "CLAUDE_EXIT_FILE", check=False).strip().partition("=")[2]
    subprocess.run(["tmux", "attach-session", "-t", name])
    if exit_file and os.path.exists(exit_file):
        m = re.search(r'"session_id":"([^"]*)"', Path(exit_file).read_text())
        if m:
            print(f"\n\033[90mResume this session with:\n  claude --resume {m.group(1)}\n\033[0m")
        os.remove(exit_file)


def cmd_status(_args):
    data = load_snapshot()
    if data is None:
        die(f"no snapshot at {SNAPSHOT}")
    print(f"Snapshot from {time.ctime(data['saved_at'])} ({data.get('phase', 'saved')})")
    for e in data["sessions"]:
        print(describe(e))


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    for name in ("save", "down"):
        s = sub.add_parser(name)
        s.add_argument("--force", action="store_true", help="snapshot even with busy or unresolvable sessions")
        if name == "down":
            s.add_argument("-y", "--yes", action="store_true", help="skip the confirmation prompt")
    r = sub.add_parser("restore")
    r.add_argument("--no-tabs", action="store_true", help="resume sessions but don't open Ghostty tabs")
    a = sub.add_parser("attach")
    a.add_argument("--wait", action="store_true", help="block until restore has opened every tab")
    a.add_argument("name")
    sub.add_parser("status")
    args = p.parse_args()
    {"save": cmd_save, "down": cmd_down, "restore": cmd_restore, "attach": cmd_attach, "status": cmd_status}[args.cmd](args)


if __name__ == "__main__":
    main()
