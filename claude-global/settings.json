{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(ls:*)",
      "Bash(git *)",
      "Bash(which:*)",
      "Bash(brew list:*)"
    ],
    "deny": []
  },
  "autoUpdatesChannel": "latest",
  "attribution": {
    "pr": ""
  },
  "env": {
    "CLAUDE_CODE_SCROLL_SPEED": "3"
  },
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "respondToBashCommands": false,
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "dark-daltonized",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "refreshInterval": 1
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'test -z \"$CLAUDE_EXIT_FILE\" || cat > \"$CLAUDE_EXIT_FILE\"'"
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.dotfiles/claude-global/hooks/session-start-tmux-rename.sh\""
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.dotfiles/claude-global/hooks/session-start-tmux-describe.sh\""
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.dotfiles/claude-global/hooks/session-start-drift-check.sh\""
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.dotfiles/claude-global/hooks/session-start-time.sh\""
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.dotfiles/claude-global/hooks/session-start-cwd-anchor.sh\""
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.dotfiles/claude-global/hooks/session-start-stack-open.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.dotfiles/claude-global/hooks/user-prompt-terminal-size.sh\""
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.dotfiles/claude-global/hooks/user-prompt-git-remote.sh\""
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.dotfiles/claude-global/hooks/user-prompt-last-message-stale.sh\""
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.dotfiles/claude-global/hooks/user-prompt-cwd-report.sh\""
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.dotfiles/claude-global/hooks/user-prompt-reply-conventions.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.dotfiles/claude-global/hooks/stop-terminal-size.py\""
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.dotfiles/claude-global/hooks/stop-last-message-time.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.dotfiles/claude-global/hooks/session-end-cleanup-chrome-mcp.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.dotfiles/claude-global/hooks/protect-settings.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.dotfiles/claude-global/hooks/pretool-cd-guard.sh\""
          },
          {
            "type": "command",
            "command": "sh \"$HOME/.dotfiles/claude-global/hooks/pretool-pr-authoring-reminder.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__plugin_github_github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.dotfiles/claude-global/hooks/pretool-pr-authoring-reminder.sh\""
          }
        ]
      },
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.dotfiles/claude-global/hooks/pretool-deny-artifacts.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.dotfiles/claude-global/hooks/remerge-on-settings-edit.sh\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.dotfiles/claude-global/hooks/docs-refs-notify.py\""
          }
        ]
      }
    ]
  }
}
