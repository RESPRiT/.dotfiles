#!/usr/bin/env python3
"""Snapshot, shut down, and restore every Claude Code session running in tmux.

  claude-sessions save      snapshot sessions (no shutdown)
  claude-sessions down      snapshot, then /exit every session
  claude-sessions restore   resume every snapshotted session, re-enter
                            worktrees, refill drafts, reopen Ghostty tabs
  claude-sessions attach X  attach a restored wrapper session (what each tab runs)
  claude-sessions status    print the snapshot

Two kinds of session are handled, each recorded with its `mode`:

  wrapper  a tmux session of its own, named claude-<sid8> by the shellrc
           claude() wrapper; restored as a new session plus (macOS) a Ghostty tab.
  pane     a claude running in a pane of the user's own tmux session; restored
           as a window in that session, in saved order. A session tmux numbered
           itself ("0", "1", ...) is treated as unnamed: restore puts its windows
           into the current tmux session, or a new one when run outside tmux.
           --into SESSION overrides the target for every pane entry.

Run `down` from a pane or tab that isn't one of the sessions it exits.
"""

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

STATE_DIR = Path.home() / ".local/state/claude-sessions"
SNAPSHOT = STATE_DIR / "snapshot.json"
EXIT_DIR = Path.home() / ".local/state/claude-wrapper"
PROJECTS = Path.home() / ".claude/projects"
# Claude Code's per-process registry: <pid>.json holds that process's current sessionId.
LIVE_SESSIONS = Path.home() / ".claude/sessions"
SESSION_RE = re.compile(r"^claude-[0-9a-f]{8}$")
SHELLS = {"zsh", "bash", "sh", "dash", "fish"}
PANE_FMT = "\t".join(
    [
        "#{session_name}", "#{window_index}", "#{window_name}", "#{automatic-rename}", "#{pane_index}",
        "#{pane_id}", "#{pane_pid}", "#{pane_width}", "#{pane_height}", "#{pane_title}", "#{@claude-session-id}",
    ]
)
# Spinner line while a turn is running, e.g. "✽ Coalescing… (2m 33s · ↓ 13.8k tokens"
BUSY_RE = re.compile(r"…\s*\((\d+[hms]\s*)+")
ANSI_RE = re.compile(r"\x1b\[[0-9;:?]*[A-Za-z]|\x1b\][^\x07]*\x07")
DIM = "\x1b[2m"
# A selection dialog also renders "❯ 1. Yes" between rules; only a bare ❯ is the prompt.
PROMPT_RE = re.compile(r"^❯(?!\s*\d+\.)")
LOSSY_RE = re.compile(r"\[(Pasted text|Image) #\d+")
TASK_RE = re.compile(r"eval '((?:[^']|'\\'')*)' < /dev/null")
# Claude's "exit while in a worktree" dialog; any Remove option runs the WorktreeRemove hook.
WORKTREE_DIALOG = "Exiting worktree session"
KEEP_RE = re.compile(r"^(❯\s*)?\d+\.\s+Keep worktree\b")
OPTION_RE = re.compile(r"^(❯\s*)?\d+\.\s+\S")
# Running subagent row in the panel under the input box, e.g. "❯ ⏺ code-reviewer  Verifying … 5m 53s · ↓ 113.4k tokens"
AGENT_ROW_RE = re.compile(r"⏺ .*\d+[hms] · [↓↑]")
EXIT_TIMEOUT = 30
RULE_MIN = 20
# Ghostty stable and Nightly share a bundle id; only Nightly has the AppleScript dictionary.
GHOSTTY_APP = os.environ.get("CLAUDE_SESSIONS_GHOSTTY_APP", "/Applications/Ghostty Nightly.app")


def die(msg):
    print(f"claude-sessions: {msg}", file=sys.stderr)
    sys.exit(1)


def warn(msg):
    print(f"  ! {msg}", file=sys.stderr)


def tmux(*args, check=True, input=None):
    r = subprocess.run(["tmux", *args], capture_output=True, text=True, input=input)
    if check and r.returncode != 0:
        raise RuntimeError(f"tmux {' '.join(args)}: {r.stderr.strip()}")
    return r.stdout


def proc_comm(pid):
    r = subprocess.run(["ps", "-o", "comm=", "-p", str(pid)], capture_output=True, text=True)
    return r.stdout.strip()


def is_claude_pid(pid):
    return "claude" in proc_comm(pid)


def proc_table():
    """pid -> (ppid, comm) for every process."""
    r = subprocess.run(["ps", "-A", "-o", "pid=,ppid=,comm="], capture_output=True, text=True)
    procs = {}
    for line in r.stdout.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3:
            procs[int(parts[0])] = (int(parts[1]), parts[2])
    return procs


def claude_in_pane(pane_pid, procs):
    """The pane's claude: the pane root itself, or a direct child of the pane's shell."""
    if "claude" in procs.get(pane_pid, (0, ""))[1]:
        return pane_pid
    return next((pid for pid, (ppid, comm) in procs.items() if ppid == pane_pid and "claude" in comm), None)


def registry_session_id(pid):
    try:
        data = json.loads((LIVE_SESSIONS / f"{pid}.json").read_text())
    except (OSError, ValueError):
        return None
    return data.get("sessionId") if data.get("pid") == pid else None


def live_session_ids():
    """Session ids of every running claude, from the registry and the hook's pane stamps."""
    procs = proc_table()
    ids = set()
    for f in LIVE_SESSIONS.glob("*.json"):
        pid = int(f.stem) if f.stem.isdigit() else None
        if pid in procs and "claude" in procs[pid][1]:
            ids.add(registry_session_id(pid))
    panes = tmux("list-panes", "-a", "-F", "#{pane_pid}\t#{@claude-session-id}", check=False)
    for line in panes.splitlines():
        pane_pid, _, sid = line.partition("\t")
        if sid and claude_in_pane(int(pane_pid), procs):
            ids.add(sid)
    ids.discard(None)
    return ids


def is_wrapper_session(name):
    if SESSION_RE.match(name):
        return True
    env = tmux("show-environment", "-t", f"={name}", "CLAUDE_EXIT_FILE", check=False)
    return env.startswith("CLAUDE_EXIT_FILE=")


def proc_cwd(pid):
    r = subprocess.run(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"], capture_output=True, text=True)
    for line in r.stdout.splitlines():
        if line.startswith("n"):
            return line[1:]
    return None


def background_tasks(pid):
    """Commands of background Bash/Monitor shells the claude process owns; they die with it."""
    r = subprocess.run(["ps", "-A", "-o", "pid=,ppid=,command="], capture_output=True, text=True)
    tasks = []
    for line in r.stdout.splitlines():
        child, ppid, command = line.split(None, 2)
        if int(ppid) != pid or "/.claude/shell-snapshots/" not in command:
            continue
        m = TASK_RE.search(command)
        tasks.append(m.group(1).replace("'\\''", "'") if m else command)
    return tasks


def plain(line):
    return ANSI_RE.sub("", line)


def capture(target):
    """Pane lines with SGR escapes kept, so dim suggestion text can be told from typed text."""
    return tmux("capture-pane", "-p", "-e", "-J", "-t", target).splitlines()


def is_rule(line):
    # A named session draws its title into the top rule: "──── Some title ─".
    s = plain(line).strip()
    return len(s) >= RULE_MIN and s.startswith("─" * RULE_MIN) and s.endswith("─")


def input_box(lines):
    """Index bounds (top_rule, bottom_rule) of the bottom-most ruled box, or None."""
    rules = [i for i, l in enumerate(lines) if is_rule(l)]
    if len(rules) < 2:
        return None
    return rules[-2], rules[-1]


def prompt_body(lines):
    """Raw lines of the prompt input box, or None if the box is a dialog/other mode."""
    box = input_box(lines)
    if box is None:
        return None
    body = lines[box[0] + 1 : box[1]]
    if not body or not PROMPT_RE.match(plain(body[0])):
        return None
    return body


def read_draft(lines):
    """Typed, unsent input text; None when empty or only a dim suggestion is shown."""
    body = prompt_body(lines)
    if body is None:
        return None
    typed = [plain(raw.split(DIM, 1)[0]).rstrip() for raw in body]
    out = [typed[0].lstrip()[1:].strip()]
    out += [l[2:] if l.startswith("  ") else l for l in typed[1:]]
    text = "\n".join(out).strip()
    return text or None


def is_busy(lines):
    """A turn is running, or a subagent is (its row sits below the box and it dies with /exit)."""
    box = input_box(lines)
    above = lines[: box[0]] if box else lines
    below = lines[box[1] + 1 :] if box else []
    return any(BUSY_RE.search(plain(l)) for l in above[-15:]) or any(AGENT_ROW_RE.search(plain(l)) for l in below)


def draft_caveat(lines, width):
    """Why a draft can't round-trip exactly, or None."""
    body = prompt_body(lines) or []
    text = "\n".join(plain(l) for l in body)
    if LOSSY_RE.search(text):
        return "contains a paste/image placeholder; its content is not saved"
    if len(body) > 1 and any(len(plain(l).rstrip()) >= width - 4 for l in body[:-1]):
        return "may be soft-wrapped; wrapped lines come back as separate lines"
    return None


def transcript_for(sid8):
    hits = sorted(PROJECTS.glob(f"*/{sid8}*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
    return hits[0] if hits else None


def transcript_cwd(path):
    """First recorded cwd: the directory `claude --resume` must run from."""
    with open(path) as f:
        for line in f:
            m = re.search(r'"cwd":"([^"]*)"', line)
            if m:
                return m.group(1)
    return None


def leader_pane(session):
    panes = tmux("list-panes", "-s", "-t", session, "-F", "#{pane_id} #{pane_pid} #{pane_width} #{pane_height}")
    leader = tmux("show", "-t", session, "-v", "@claude-leader-pid", check=False).strip()
    rows = [p.split() for p in panes.splitlines()]
    for pid_match in ([leader] if leader else []) + [None]:
        for pane_id, pid, w, h in rows:
            if (pid_match is None or pid == pid_match) and is_claude_pid(pid):
                return pane_id, int(pid), int(w), int(h)
    return None


GHOSTTY_TABS = """
set sep to character id 9
set out to ""
tell application {app}
  set wi to 0
  repeat with w in windows
    set wi to wi + 1
    repeat with t in tabs of w
      set ft to focused terminal of t
      set out to out & wi & sep & (index of t) & sep & (tty of ft) & sep & (name of ft) & sep & (name of t) & linefeed
    end repeat
  end repeat
end tell
return out
"""


def osascript(script):
    r = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip())
    return r.stdout


def ghostty_tabs():
    """tty -> {window, index, title}; title is set only when the tab was renamed. {} without Ghostty scripting."""
    try:
        out = osascript(GHOSTTY_TABS.replace("{app}", applescript_str(GHOSTTY_APP)))
    except RuntimeError as ex:
        warn(f"can't read Ghostty tabs ({ex}); tab layout and names won't be restored")
        return {}
    tabs = {}
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) != 5:
            continue
        window, index, tty, term_title, tab_title = parts
        tabs[tty] = {
            "window": int(window),
            "index": int(index),
            # A renamed tab's title overrides the terminal's; otherwise they match.
            "title": tab_title if tab_title != term_title else None,
        }
    return tabs


def tab_for(session, tabs):
    ttys = tmux("list-clients", "-t", session, "-F", "#{client_tty}", check=False).split()
    return next((tabs[t] for t in ttys if t in tabs), None)


def session_entry(name, pane_id, pid, w, h, transcript, **extra):
    launch_cwd = transcript_cwd(transcript)
    live_cwd = proc_cwd(pid)
    lines = capture(pane_id)
    return {
        "name": name,
        "session_id": transcript.stem,
        "launch_cwd": launch_cwd,
        "worktree": live_cwd if live_cwd and live_cwd != launch_cwd else None,
        "draft": read_draft(lines),
        "draft_caveat": draft_caveat(lines, w),
        "at_prompt": prompt_body(lines) is not None,
        "background_tasks": background_tasks(pid),
        "busy": is_busy(lines),
        "title": tmux("display", "-p", "-t", pane_id, "#{pane_title}").strip(),
        "size": [w, h],
        **extra,
        "pane": pane_id,
        "pid": pid,
    }


def snapshot_sessions():
    sessions = tmux("list-sessions", "-F", "#S", check=False).splitlines()
    wrapped = [n for n in sessions if is_wrapper_session(n)]
    names = [n for n in wrapped if SESSION_RE.match(n)]
    tabs = ghostty_tabs() if names and sys.platform == "darwin" else {}
    entries, problems = [], []
    for name in names:
        sid8 = name[len("claude-") :]
        pane = leader_pane(name)
        if pane is None:
            problems.append(f"{name}: no live claude pane")
            continue
        pane_id, pid, w, h = pane
        transcript = transcript_for(sid8)
        if transcript is None:
            problems.append(f"{name}: no transcript matching {sid8}* under {PROJECTS}")
            continue
        entries.append(session_entry(name, pane_id, pid, w, h, transcript, mode="wrapper", tab=tab_for(name, tabs)))
    for name in wrapped:
        if name not in names:
            problems.append(f"{name}: wrapper session without a claude-<sid8> name (rename hook lost a prefix clash?)")

    procs = proc_table()
    leaders = {e["pane"] for e in entries}
    for line in tmux("list-panes", "-a", "-F", PANE_FMT, check=False).splitlines():
        session, window, window_name, auto_rename, pane_index, pane_id, pane_pid, w, h, _title, stamped = line.split("\t")
        if session in wrapped:
            # A second claude in a wrapper session isn't saved, and dies when the leader's session is killed.
            if session in names and pane_id not in leaders and claude_in_pane(int(pane_pid), procs):
                problems.append(f"{session}: extra claude in pane {pane_id} isn't saved and dies with the session")
            continue
        pid = claude_in_pane(int(pane_pid), procs)
        if pid is None:
            continue
        name = f"{session}:{window}"
        sid = registry_session_id(pid) or stamped
        if not sid:
            problems.append(f"{name}: can't tell which session claude (pid {pid}) is running")
            continue
        transcript = transcript_for(sid)
        if transcript is None:
            problems.append(f"{name}: no transcript for {sid} under {PROJECTS}")
            continue
        loc = {
            "session": session,
            "window": int(window),
            "pane": int(pane_index),
            # Only a name the user set; an automatic one would freeze if passed to new-window -n.
            "window_name": window_name if auto_rename == "0" else None,
        }
        entries.append(session_entry(name, pane_id, pid, int(w), int(h), transcript, mode="pane", tmux=loc))
    entries.sort(key=entry_order)
    return entries, problems


def entry_order(e):
    """Wrapper sessions in Ghostty tab order, then pane sessions in tmux window order."""
    if e.get("mode") == "pane":
        loc = e["tmux"]
        return (1, loc["session"], loc["window"], loc["pane"])
    tab = e.get("tab")
    return (0, "", tab["window"], tab["index"]) if tab else (2, "", 0, 0)


def load_snapshot():
    return json.loads(SNAPSHOT.read_text()) if SNAPSHOT.exists() else None


def write_snapshot(entries, phase):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    prev = load_snapshot()
    if prev is not None:
        backup = STATE_DIR / f"snapshot.{int(prev['saved_at'])}.json"
        if not backup.exists():
            shutil.copy2(SNAPSHOT, backup)
    keep = [{k: v for k, v in e.items() if k not in ("pane", "pid", "busy", "at_prompt")} for e in entries]
    tmp = SNAPSHOT.with_suffix(".tmp")
    tmp.write_text(json.dumps({"saved_at": time.time(), "phase": phase, "sessions": keep}, indent=2))
    tmp.replace(SNAPSHOT)


def set_phase(phase):
    data = load_snapshot()
    data["phase"] = phase
    tmp = SNAPSHOT.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2))
    tmp.replace(SNAPSHOT)


def describe(e):
    bits = [e["name"], e["title"]]
    if (e.get("tab") or {}).get("title"):
        bits.append(f"tab={e['tab']['title']!r}")
    if e.get("worktree"):
        bits.append(f"worktree={e['worktree']}")
    if e.get("draft"):
        bits.append(f"draft={e['draft']!r}")
    for t in e.get("background_tasks") or []:
        bits.append(f"task={t[:60]!r}")
    return "  " + " | ".join(bits)


def cmd_save(args, phase="saved"):
    entries, problems = snapshot_sessions()
    for p in problems:
        warn(p)
    if problems and not args.force:
        die("refusing to snapshot with unresolved sessions (--force to skip them)")
    busy = [e for e in entries if e["busy"]]
    if busy and not args.force:
        for e in busy:
            warn(f"{e['name']} is mid-turn ({e['title']})")
        die("wait for these turns to finish, or pass --force")
    for e in entries:
        if not e["at_prompt"]:
            warn(f"{e['name']}: no idle ❯ prompt (dialog or bash/memory mode open?); its draft isn't saved")
        if e["draft_caveat"]:
            warn(f"{e['name']}: draft {e['draft_caveat']}")
    tasked = [e for e in entries if e["background_tasks"]]
    if tasked and phase == "down-started" and not args.force:
        for e in tasked:
            for t in e["background_tasks"]:
                warn(f"{e['name']} has a background task that /exit will kill: {t[:100]}")
        die("stop these (or pass --force to let them die; the resumed agent is told which ones ended)")

    # Until a restore consumes the snapshot, sessions that already exited live only there; keep them.
    prev = load_snapshot()
    carried = []
    if prev and prev.get("phase") != "restored" and not args.fresh:
        live_ids = {e["session_id"] for e in entries}
        carried = [e for e in prev["sessions"] if e["session_id"] not in live_ids]
    if not entries and not carried and prev and prev["sessions"] and not args.fresh:
        die(f"no live sessions; refusing to overwrite the {len(prev['sessions'])}-session snapshot (--fresh to do it)")
    for e in carried:
        print(f"  carrying forward {e['name']} (not running; --fresh drops it)")
    saved = sorted(carried + entries, key=entry_order)
    write_snapshot(saved, phase)

    print(f"Saved {len(saved)} sessions to {SNAPSHOT}")
    for e in saved:
        print(describe(e))
    return entries


def wait_until(pred, timeout, interval=0.5):
    end = time.time() + timeout
    while time.time() < end:
        if pred():
            return True
        time.sleep(interval)
    return False


def parallel(fn, entries):
    """fn(e) per session on its own thread; an exception becomes that session's error string."""

    def guarded(e):
        try:
            return fn(e)
        except Exception as ex:  # one session's surprise must not abandon the others mid-exit
            return f"{e['name']}: {type(ex).__name__}: {ex}"

    if not entries:
        return []
    with ThreadPoolExecutor(max_workers=len(entries)) as pool:
        return list(pool.map(guarded, entries))


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False


def exit_session(e):
    pane = e["pane"]
    for _ in range(3):
        lines = capture(pane)
        if is_busy(lines):
            return f"{e['name']}: a turn or subagent is running; let it finish, then rerun `down`"
        if prompt_body(lines) is None:
            return f"{e['name']}: no idle ❯ prompt (dialog or bash/memory mode open?); exit it by hand"
        if read_draft(lines) is None:
            break
        # Ctrl-C clears a non-empty draft; it's only sent while text is present, so it can't double-tap quit.
        tmux("send-keys", "-t", pane, "C-c")
        time.sleep(0.4)
    if read_draft(capture(pane)) is not None:
        return f"could not clear the draft in {e['name']}"
    tmux("send-keys", "-t", pane, "-l", "--", "/exit")
    time.sleep(0.4)
    if read_draft(capture(pane)) != "/exit":
        tmux("send-keys", "-t", pane, "C-c")
        return f"input in {e['name']} did not read back as /exit; aborted"
    tmux("send-keys", "-t", pane, "Enter")
    # Never signal claude: a killed exit falls through to the worktree remove hook.
    deadline = time.time() + EXIT_TIMEOUT
    answered_at = None
    while time.time() < deadline:
        if not pid_alive(e["pid"]):
            # A pane session's window stays, back at its shell; only a wrapper owns its tmux session.
            if e["mode"] == "wrapper":
                tmux("kill-session", "-t", f"={e['name']}", check=False)
            return None
        try:
            options = worktree_dialog(pane)
        except RuntimeError:
            time.sleep(0.5)
            continue
        # Re-answer only if the dialog is still up well after the last Enter.
        if options and (answered_at is None or time.time() - answered_at > 3):
            err = choose_keep(pane, options)
            if err:
                tmux("send-keys", "-t", pane, "Escape")
                return f"{e['name']}: {err}; answer its worktree dialog with Keep by hand — DON'T reboot first"
            answered_at = time.time()
            print(f"  {e['name']}: kept worktree {e.get('worktree')}")
        time.sleep(0.5)
    return f"{e['name']} (pid {e['pid']}) did not exit within {EXIT_TIMEOUT}s; left running — DON'T reboot until it's closed"


def worktree_dialog(pane):
    """Option lines of the worktree-exit dialog from a stable screen, or None if it isn't showing."""
    first = capture(pane)
    time.sleep(0.4)
    raw = capture(pane)
    if raw != first:
        return None
    lines = [plain(l).strip() for l in raw]
    head = max((i for i, l in enumerate(lines) if WORKTREE_DIALOG in l), default=None)
    # The dialog replaces the prompt; a ❯ input box below the header means it's only transcript text.
    if head is None or prompt_body(raw[head:]) is not None:
        return None
    return [l for l in lines[head + 1 :] if OPTION_RE.match(l)] or None


def choose_keep(pane, options):
    """Move the dialog's highlight onto a Keep option, confirm it from a stable screen, then press Enter."""
    current = next((i for i, l in enumerate(options) if l.startswith("❯")), None)
    target = next((i for i, l in enumerate(options) if KEEP_RE.match(l)), None)
    if current is None or target is None:
        return "could not read the worktree dialog"
    if current != target:
        # Moves are computed once; re-deciding from a lagging screen could overshoot onto Remove.
        tmux("send-keys", "-t", pane, *(["Down" if target > current else "Up"] * abs(target - current)))
        for _ in range(10):
            options = worktree_dialog(pane)
            if options and any(l.startswith("❯") and KEEP_RE.match(l) for l in options):
                break
        else:
            return "could not confirm Keep is highlighted"
    tmux("send-keys", "-t", pane, "Enter")
    return None


def cmd_down(args):
    here = os.environ.get("TMUX_PANE")
    here_session = tmux("display", "-p", "-t", here, "#S", check=False).strip() if here else None
    prev_phase = (load_snapshot() or {}).get("phase", "saved")
    entries = cmd_save(args, phase="down-started")
    if any(e["pane"] == here or (e["mode"] == "wrapper" and e["name"] == here_session) for e in entries):
        set_phase(prev_phase)
        die("this pane is one of the sessions `down` would exit; run it from another pane or tab")
    if not args.yes:
        if input(f"\nExit {len(entries)} running sessions? [y/N] ").strip().lower() != "y":
            set_phase(prev_phase)
            die("aborted; snapshot kept")
    print(f"exiting {len(entries)} sessions in parallel …")
    failures = [err for err in parallel(exit_session, entries) if err]
    for err in failures:
        warn(err)
    if failures:
        die(f"{len(failures)} session(s) still need attention; fix them, then rerun `down` (the snapshot keeps the rest)")
    set_phase("down-complete")
    print("\nAll sessions exited. After the restart, run: claude-sessions restore")


def ready(pane):
    try:
        lines = capture(pane)
    except RuntimeError:
        return False
    return prompt_body(lines) is not None and not is_busy(lines)


def input_empty(pane):
    lines = capture(pane)
    return prompt_body(lines) is not None and read_draft(lines) is None


def launch(e):
    claude_bin = shutil.which("claude")
    if claude_bin is None:
        raise RuntimeError("claude not on PATH")
    EXIT_DIR.mkdir(parents=True, exist_ok=True)
    fd, exit_file = tempfile.mkstemp(prefix="claude-exit.", dir=EXIT_DIR)
    os.close(fd)
    w, h = e["size"]
    # Mirrors the shellrc claude() wrapper; destroy-unattached is set on first attach instead.
    tmux(
        "new-session", "-d", "-s", e["name"], "-x", str(w), "-y", str(h), "-c", e["launch_cwd"],
        "-e", "CLAUDE_CODE_TMUX_TRUECOLOR=1", "-e", f"CLAUDE_EXIT_FILE={exit_file}", "-e", "COLORTERM=truecolor",
        f"{claude_bin} --resume {e['session_id']}",
    )
    tmux("set", "-t", e["name"], "status-style", "bg=colour238 fg=colour250")
    tmux("set", "-t", e["name"], "@claude-running", "1")
    tmux("set", "-t", e["name"], "-F", "@claude-leader-pid", "#{pane_pid}")
    pane, pid = tmux("display", "-p", "-t", e["name"], "#{pane_id} #{pane_pid}").split()
    e["pane"], e["pid"] = pane, int(pid)


def has_session(name):
    return subprocess.run(["tmux", "has-session", "-t", f"={name}"], capture_output=True).returncode == 0


def idle_shell(target, cwd):
    """(pane_id, pane_pid) when target is a bare shell sitting in cwd, e.g. a window `down` left behind."""
    fmt = "#{pane_id}\t#{pane_pid}\t#{pane_current_command}\t#{pane_current_path}"
    parts = tmux("display", "-p", "-t", target, fmt, check=False).strip().split("\t")
    if len(parts) != 4 or parts[2] not in SHELLS or parts[3] != cwd:
        return None
    return parts[0], int(parts[1])


def launch_pane(e, target, reusable):
    """Resume a pane session as a window of tmux session `target` (None: a new unnamed one); returns its session.

    Only panes in `reusable` may be typed into: a window this run just made still looks like an idle shell
    while its shell starts, and keys typed there would reach the claude it is about to launch.
    """
    loc, sid = e["tmux"], e["session_id"]
    fmt = "#{session_name}\t#{pane_id}\t#{pane_pid}"
    reuse = idle_shell(f"={target}:{loc['window']}.{loc['pane']}", e["launch_cwd"]) if target == loc["session"] else None
    if reuse and reuse[0] not in reusable:
        reuse = None
    if reuse:
        reusable.discard(reuse[0])
        # clear: the old claude's last frame is still on screen and would pass for a ready prompt.
        pane_id, pane_pid = reuse
        tmux("send-keys", "-t", pane_id, "C-u")
        tmux("send-keys", "-t", pane_id, "-l", "--", f"clear && claude --resume {sid}")
        tmux("send-keys", "-t", pane_id, "Enter")
        session = target
    else:
        # Through an interactive shell so the shellrc claude() wrapper marks the pane, and the
        # window falls back to a shell when claude exits, like one started by hand.
        shell = shlex.quote(os.environ.get("SHELL") or "/bin/sh")
        cmd = f"{shell} -ic {shlex.quote(f'claude --resume {sid}; exec {shell}')}"
        name = ["-n", loc["window_name"]] if loc.get("window_name") else []
        if target and has_session(target):
            out = tmux("new-window", "-d", "-a", "-t", f"={target}:{{end}}", "-P", "-F", fmt, "-c", e["launch_cwd"], *name, cmd)
        else:
            w, h = e["size"]
            new = ["new-session", "-d", *(["-s", target] if target else []), "-x", str(w), "-y", str(h)]
            out = tmux(*new, "-P", "-F", fmt, "-c", e["launch_cwd"], *name, cmd)
        session, pane_id, pane_pid = out.strip().split("\t")
        pane_pid = int(pane_pid)
    e["pane"], e["pane_pid"], e["pid"] = pane_id, pane_pid, None
    return session


def pane_target(saved, into):
    """Session a pane entry restores into; None means a new session tmux names itself."""
    if into:
        return into
    if not saved.isdigit():
        return saved
    # tmux numbered it, so the name carries no intent: use the session restore runs in, if any,
    # unless that's a wrapper session (its extra windows would be invisible to save and die with it).
    here = os.environ.get("TMUX_PANE")
    if not here:
        return None
    current = tmux("display", "-p", "-t", here, "#S", check=False).strip()
    return current if current and not is_wrapper_session(current) else None


def paste(pane, text):
    """Bracketed paste via a buffer: no tmux argv parsing of leading '-' or trailing ';'."""
    # Per-pane buffer: restores run in parallel threads and a shared one gets swapped between load and paste.
    buf = f"claude-sessions-{pane.lstrip('%')}"
    tmux("load-buffer", "-b", buf, "-", input=text)
    tmux("paste-buffer", "-p", "-d", "-b", buf, "-t", pane)


def resume_notice(worktree, tasks):
    parts = ["[claude-sessions] The machine restarted and this session was resumed."]
    if worktree:
        parts.append(
            f"Re-enter your worktree now with EnterWorktree(path: \"{worktree}\") (cd there if EnterWorktree rejects it)."
        )
    if tasks:
        listed = "; ".join(f"`{t}`" for t in tasks)
        parts.append(
            f"These background tasks were killed by the restart and will never notify you: {listed}. "
            "Don't restart them unless I ask; just note which ones you were waiting on."
        )
    parts.append("Do nothing else; reply in one or two lines.")
    return " ".join(parts)


def applescript_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def open_tabs(entries):
    """Recreate the saved Ghostty windows/tabs in order, each attaching its session, with renamed titles reapplied."""
    self_path = os.path.realpath(sys.argv[0])
    lines = [f"tell application {applescript_str(GHOSTTY_APP)}", "  activate"]
    window = None
    for i, e in enumerate(sorted(entries, key=entry_order)):
        tab = e.get("tab") or {}
        # Read the name live: the SessionStart hook may rename the session after restore_session gave up on it.
        name = tmux("display", "-p", "-t", e["pane"], "#S", check=False).strip() or e["name"]
        cmd = applescript_str(f"{self_path} attach {name}")
        lines += ["  set cfg to new surface configuration", f"  set initial input of cfg to {cmd} & linefeed"]
        if i == 0 or tab.get("window") != window:
            window = tab.get("window")
            lines += ["  set w to new window with configuration cfg", "  set t to tab 1 of w"]
        else:
            lines += ["  set t to new tab in w with configuration cfg"]
        if tab.get("title"):
            lines.append(f"  perform action {applescript_str('set_tab_title:' + tab['title'])} on focused terminal of t")
    lines.append("end tell")
    osascript("\n".join(lines))


def restore_session(e):
    """Wait for the prompt, send the resume notice (worktree, killed tasks), retype the draft."""
    pane = e["pane"]
    if e["mode"] == "pane":
        # The pane starts as a shell; wait for its claude before trusting what the screen shows.
        if not wait_until(lambda: e.update(pid=claude_in_pane(e["pane_pid"], proc_table())) or e["pid"], 30):
            return "claude never started in its pane; skipped its worktree/draft"
    if not wait_until(lambda: ready(pane), 90):
        return "never reached an idle ❯ prompt; skipped its worktree/draft"
    if e["mode"] == "pane":
        e["name"] = tmux("display", "-p", "-t", pane, "#{session_name}:#{window_index}").strip()
    else:
        # The SessionStart hook renames the session if --resume ever lands on a new id.
        e["name"] = tmux("display", "-p", "-t", pane, "#S").strip()
    worktree = e.get("worktree") if e.get("worktree") and proc_cwd(e["pid"]) != e["worktree"] else None
    tasks = e.get("background_tasks") or []
    if worktree or tasks:
        if not input_empty(pane):
            return "prompt isn't an empty ❯ input; skipped the resume notice and draft"
        print(f"  {e['name']}: sending resume notice" + (f" (worktree {worktree})" if worktree else ""))
        paste(pane, resume_notice(worktree, tasks))
        time.sleep(0.5)
        typed = read_draft(capture(pane)) or ""
        if not typed.startswith(("[claude-sessions]", "[Pasted text")):
            return f"resume notice didn't land in the input (read back {typed[:40]!r}); skipped it and the draft"
        tmux("send-keys", "-t", pane, "Enter")
        # A fast turn can start and finish between polls; an emptied input also means it was submitted.
        if not wait_until(lambda: is_busy(capture(pane)) or input_empty(pane), 15):
            return "resume notice was not submitted; skipped its draft"
        if not wait_until(lambda: ready(pane), 180):
            return "resume-notice turn still running; skipped its draft"
        if worktree and proc_cwd(e["pid"]) != worktree:
            warn(f"{e['name']}: cwd is {proc_cwd(e['pid'])}, expected {worktree}")
    if e.get("draft"):
        if not input_empty(pane):
            return "input isn't empty; skipped its draft"
        paste(pane, e["draft"])
    return None


def cmd_restore(args):
    data = load_snapshot()
    if data is None:
        die(f"no snapshot at {SNAPSHOT}")
    if args.into and is_wrapper_session(args.into):
        die(f"--into {args.into} is a claude() wrapper session; pick a session of your own")
    live_names = set(tmux("list-sessions", "-F", "#S", check=False).splitlines())
    live_ids = live_session_ids()

    todo = []
    for e in data["sessions"]:
        e.setdefault("mode", "wrapper")  # snapshots from before pane mode
        if e["session_id"] in live_ids or (e["mode"] == "wrapper" and e["name"] in live_names):
            warn(f"{e['name']} is already running; skipping")
        elif not e["launch_cwd"] or not Path(e["launch_cwd"]).is_dir():
            warn(f"{e['name']}: launch dir {e['launch_cwd']} is missing; skipping")
        else:
            if e.get("worktree") and not Path(e["worktree"]).is_dir():
                warn(f"{e['name']}: worktree {e['worktree']} is gone; resuming without it")
                e["worktree"] = None
            todo.append(e)

    started = []
    # Unnamed saved sessions that went into a new session share it: saved name -> created name.
    created = {}
    reusable = set(tmux("list-panes", "-a", "-F", "#{pane_id}", check=False).split())
    for e in sorted(todo, key=entry_order):
        try:
            if e["mode"] == "pane":
                saved = e["tmux"]["session"]
                target = pane_target(saved, args.into)
                target = created.get(saved, target) if target is None else target
                print(f"resuming {e['name']} in {e['launch_cwd']} (into {target or 'a new session'})")
                session = launch_pane(e, target, reusable)
                if target is None:
                    created[saved] = session
            else:
                print(f"resuming {e['name']} in {e['launch_cwd']}")
                launch(e)
            started.append(e)
        except RuntimeError as ex:
            warn(f"{e['name']}: {ex}")
    for e, msg in zip(started, parallel(restore_session, started)):
        if msg:
            warn(f"{e['name']}: {msg}")
    if started:
        set_phase("restored")

    wrapped = [e for e in started if e["mode"] == "wrapper"]
    panes = [e for e in started if e["mode"] == "pane"]
    tabs_opened = False
    if wrapped and not args.no_tabs and sys.platform != "darwin":
        print("\nGhostty tabs are only reopened on macOS.")
    if wrapped and not args.no_tabs and sys.platform == "darwin":
        try:
            open_tabs(wrapped)
            tabs_opened = True
            print(f"\nOpened {len(wrapped)} Ghostty tabs.")
        except RuntimeError as ex:
            warn(f"could not open Ghostty tabs ({ex})")
    if wrapped and not tabs_opened:
        print("\nAttach each with: claude-sessions attach <name>")
        for e in wrapped:
            print(f"  {e['name']}  {e['title']}")
    if not panes:
        if tabs_opened:
            print("This tab can be closed.")
        return

    print("\nRestored as tmux windows:")
    for e in panes:
        print(f"  {e['name']}  {e['title']}")
    first = panes[0]["pane"]
    session = tmux("display", "-p", "-t", first, "#S").strip()
    if args.no_attach:
        print(f"Attach with: tmux attach -t {shlex.quote(session)}")
        return
    tmux("select-window", "-t", first)
    if os.environ.get("TMUX"):
        tmux("switch-client", "-t", f"={session}")
    else:
        os.execvp("tmux", ["tmux", "attach-session", "-t", f"={session}"])


def cmd_attach(args):
    name = args.name
    exit_file = tmux("show-environment", "-t", name, "CLAUDE_EXIT_FILE", check=False).strip().partition("=")[2]
    # destroy-unattached kills a session the instant it turns on while no client is attached,
    # so it's set in the same command sequence, after the attach (as the shellrc wrapper does).
    subprocess.run(["tmux", "attach-session", "-t", name, ";", "set", "destroy-unattached", "on"])
    if exit_file and os.path.exists(exit_file):
        m = re.search(r'"session_id":"([^"]*)"', Path(exit_file).read_text())
        if m:
            print(f"\n\033[90mResume this session with:\n  claude --resume {m.group(1)}\n\033[0m")
        os.remove(exit_file)


def cmd_status(_args):
    data = load_snapshot()
    if data is None:
        die(f"no snapshot at {SNAPSHOT}")
    print(f"Snapshot from {time.ctime(data['saved_at'])} ({data.get('phase', 'saved')})")
    for e in data["sessions"]:
        print(describe(e))


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    for name in ("save", "down"):
        s = sub.add_parser(name)
        s.add_argument("--force", action="store_true", help="snapshot even with busy or unresolvable sessions")
        s.add_argument("--fresh", action="store_true", help="drop snapshotted sessions that are no longer running")
        if name == "down":
            s.add_argument("-y", "--yes", action="store_true", help="skip the confirmation prompt")
    r = sub.add_parser("restore")
    r.add_argument("--no-tabs", action="store_true", help="resume sessions but don't open Ghostty tabs")
    r.add_argument("--no-attach", action="store_true", help="don't attach/switch to the restored tmux windows")
    r.add_argument("--into", metavar="SESSION", help="restore every pane session into this tmux session")
    a = sub.add_parser("attach")
    a.add_argument("name")
    sub.add_parser("status")
    args = p.parse_args()
    {"save": cmd_save, "down": cmd_down, "restore": cmd_restore, "attach": cmd_attach, "status": cmd_status}[args.cmd](args)


if __name__ == "__main__":
    main()
